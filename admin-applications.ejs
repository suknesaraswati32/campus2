<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>All Applicants</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body {
  background: #1e1e2f;
  color: white;
}
.card {
  border-radius: 15px;
}

body {
  background: #1e1e2f;
  color: white;
}
.card {
  border-radius: 15px;
}

/* ✅ SKY BLUE BUTTON */
.btn-skyblue {
  background-color: #38bdf8;
  color: white;
  border: none;
  border-radius: 10px;
}

.btn-skyblue:hover {
  background-color: #0ea5e9;
  color: white;
}
</style>

</head>

<body>

<div class="container mt-5">

<h2 class="text-center mb-4">All Job Applicants</h2>

<% if(applications.length === 0){ %>
  <p>No applications found</p>
<% } %>

<% applications.forEach(app => { %>

<div class="card p-4 mb-4 shadow">

  <!-- JOB INFO -->
  <h4 class="text-info"><%= app.job.jobTitle %></h4>
  <p><b>Company:</b> <%= app.job.company %></p>

  <hr>

  <!-- STUDENT INFO -->
  <p><b>Name:</b> <%= app.name %></p>
  <p><b>Email:</b> <%= app.email %></p>
  <p><b>CGPA:</b> <%= app.cgpa %></p>

  <!-- SKILLS -->
  <p><b>Skills:</b>
    <% app.skills.forEach(skill => { %>
      <span class="badge bg-primary"><%= skill %></span>
    <% }) %>
  </p>

  <hr>

  <!-- EDUCATION -->
  <p><b>12th Marks:</b> <%= app.twelfthMarks %></p>
  <p><b>College:</b> <%= app.college %></p>
  <p><b>Degree:</b> <%= app.degree %></p>

  <hr>

  <!-- STATUS -->
  <p>
    <b>Status:</b>
    <span class="badge bg-warning"><%= app.status %></span>
  </p>

  <p><b>Applied On:</b> <%= app.appliedDate.toDateString() %></p>

  <!-- RESUME -->
  <% if(app.resume){ %>
   <a href="/uploads/<%= app.resume %>" target="_blank" class="btn btn-skyblue">
  View Resume
</a>
  <% } %>

</div>

<% }) %>

</div>

</body>
</html>