
<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<title>Jobs</title>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<!-- Custom CSS -->
<link rel="stylesheet" href="/css/style.css">

<style>

/* Sky Blue Button */
.btn-skyblue {
  background-color: #38bdf8;
  color: white;
  border: none;
}

.btn-skyblue:hover {
  background-color: #0ea5e9;
  color: white;
}

</style>

</head>

<body>

<!-- ✅ NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">

<div class="container">

<a class="navbar-brand logo" href="#">CampusHire</a>

<div class="collapse navbar-collapse">

<ul class="navbar-nav ms-auto align-items-center">

<li class="nav-item"><a class="nav-link" href="#">Dashboard</a></li>
<li class="nav-item"><a class="nav-link" href="#">Jobs</a></li>
<li class="nav-item"><a class="nav-link" href="#">Applications</a></li>
<li class="nav-item"><a class="nav-link" href="#">Profile</a></li>

<!-- ✅ SKY BLUE BUTTON RIGHT SIDE -->
<li class="nav-item ms-3">
<a href="/jobs/new" class="btn btn-skyblue">Add Job</a>
</li>

</ul>

</div>

</div>

</nav>


<!-- ✅ HERO SECTION -->

<section class="hero">

<div class="container text-center">

<h1>Explore Jobs</h1>
<p>Find the best opportunities for your career</p>

</div>

</section>


<!-- ✅ JOB SECTION -->

<section class="jobs-section">

<div class="container">

<h3 class="mb-4">Available Jobs</h3>

<div class="row">

  <% jobs.forEach(job => { %>

    <div class="col-md-4 mb-4">
      <div class="card shadow h-100">

        <img src="https://source.unsplash.com/400x300/?office,technology"
        class="card-img-top">

        <div class="card-body">

          <h5><%= job.jobTitle %></h5>

          <p>
            <b>Company:</b> <%= job.company %> <br>
            <b>Location:</b> <%= job.location || "N/A" %> <br>
            <b>Package:</b> ₹<%= job.package || "N/A" %> LPA
          </p>

          <div class="mb-2">
            <% if(job.requiredSkills){ %>
              <% job.requiredSkills.forEach(skill => { %>
                <span class="badge bg-primary me-1"><%= skill %></span>
              <% }) %>
            <% } %>
          </div>

          <p>
            <b>CGPA:</b> <%= job.minimumCGPA || "N/A" %><br>
            <b>Deadline:</b> <%= job.deadline ? job.deadline.toDateString() : "N/A" %>
          </p>

           <a href="/apply/<%= job._id %>" class="btn btn-primary w-100">
             Apply
           </a>
        </div>

      </div>
    </div>

  <% }) %>

</div>

</div>

</section>


<!-- ✅ FOOTER -->

<footer class="footer">

<div class="container">

<div class="row">

<div class="col-md-4">
<h5>CampusHire</h5>
<p>Connecting students with top companies for campus placements.</p>
</div>

<div class="col-md-4">
<h5>Quick Links</h5>
<ul>
<li>Dashboard</li>
<li>Jobs</li>
<li>Applications</li>
<li>Profile</li>
</ul>
</div>

<div class="col-md-4">
<h5>Contact</h5>
<p>Email: support@campushire.com</p>
<p>Phone: +91 9876543210</p>
</div>

</div>

<hr>

<p class="text-center">© 2026 CampusHire | Placement Portal</p>

</div>

</footer>
<script>
function applyJob(jobId){
  window.location.href = `/apply/${jobId}`;
}
</script>
</body>
</html>