<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<title>Company Dashboard</title>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<!-- Custom CSS -->
<link rel="stylesheet" href="/css/style.css">

<style>
.company-card{
    border:none;
    border-radius:20px;
    transition:0.3s ease;
}

.company-card:hover{
    transform:translateY(-5px);
}

.action-btn{
    padding:12px;
    border-radius:10px;
    font-weight:500;
}
</style>

</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">

<div class="container">

<a class="navbar-brand logo" href="#">
CampusHire
</a>

<ul class="navbar-nav ms-auto">

<li class="nav-item">
<a class="nav-link" href="/company-dashboard">
Dashboard
</a>
</li>

<li class="nav-item">
<a class="nav-link" href="/company/jobs/new">
Post Job
</a>
</li>

<li class="nav-item">
<a class="nav-link" href="/company/applications">
Applicants
</a>
</li>

<li class="nav-item">
<a class="nav-link" href="/company/logout">
Logout
</a>
</li>

</ul>

</div>

</nav>

<!-- HERO SECTION -->
<section class="hero">

<div class="container">

<h1>
Welcome <%= company.companyName %> 👋
</h1>

<p>
Manage your jobs and recruit talented students easily
</p>

<!-- COMPANY INFO -->
<p><b>Email:</b> <%= company.email %></p>
<p><b>Industry:</b> <%= company.industry %></p>

<!-- LOCATION -->
<div class="mb-3">
<b>Location:</b>
<span class="badge bg-light text-dark">
<%= company.location || "Not Added" %>
</span>
</div>

<!-- SEARCH -->
<input 
type="text"
class="form-control search-bar"
placeholder="Search posted jobs..."
>

</div>

</section>

<!-- DASHBOARD SECTION -->
<section class="jobs-section">

<div class="container">

<h3 class="mb-4">Company Overview</h3>

<div class="row">

<!-- TOTAL JOBS -->
<div class="col-md-4 mb-4">
<div class="card shadow p-4 company-card">

<h5>Total Jobs Posted</h5>

<h2 class="mt-3 text-primary">
<%= company.postedJobs.length %>
</h2>

</div>
</div>

<!-- INDUSTRY -->
<div class="col-md-4 mb-4">
<div class="card shadow p-4 company-card">

<h5>Industry</h5>

<h2 class="mt-3 text-success">
<%= company.industry || "N/A" %>
</h2>

</div>
</div>

<!-- LOCATION -->
<div class="col-md-4 mb-4">
<div class="card shadow p-4 company-card">

<h5>Location</h5>

<h2 class="mt-3 text-warning">
<%= company.location || "N/A" %>
</h2>

</div>
</div>

</div>

<!-- QUICK ACTIONS -->
<h3 class="mb-4 mt-4">Quick Actions</h3>

<div class="row">

<div class="col-md-3 mb-4">
<a href="/company/jobs/new" 
class="btn btn-primary w-100 action-btn">
Post Job
</a>
</div>

<div class="col-md-3 mb-4">
<a href="/company/jobs" 
class="btn btn-success w-100 action-btn">
Manage Jobs
</a>
</div>

<div class="col-md-3 mb-4">
<a href="/company/applications" 
class="btn btn-warning w-100 action-btn">
View Applicants
</a>
</div>

<div class="col-md-3 mb-4">
<a href="/company/analytics" 
class="btn btn-dark w-100 action-btn">
Analytics
</a>
</div>

</div>

</div>

</section>

<!-- FOOTER -->
<footer class="footer">

<div class="container">

<div class="row">

<div class="col-md-4">
<h5>CampusHire</h5>
<p>
Helping companies hire talented students for campus placements.
</p>
</div>

<div class="col-md-4">
<h5>Quick Links</h5>
<ul>
<li>Dashboard</li>
<li>Post Job</li>
<li>Applicants</li>
<li>Analytics</li>
</ul>
</div>

<div class="col-md-4">
<h5>Contact</h5>
<p>Email: support@campushire.com</p>
<p>Phone: +91 9876543210</p>
</div>

</div>

<hr>

<p class="text-center">
© 2026 CampusHire | Placement Portal
</p>

</div>

</footer>

</body>
</html>