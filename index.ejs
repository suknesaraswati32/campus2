<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<title>Student Dashboard</title>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<!-- Custom CSS -->
<link rel="stylesheet" href="/css/style.css">

</head>

<body>

<!-- ✅ NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">

<div class="container">

<a class="navbar-brand logo" href="#">CampusHire</a>

<ul class="navbar-nav ms-auto">

<li class="nav-item"><a class="nav-link" href="#">Dashboard</a></li>
<li class="nav-item"><a class="nav-link" href="/jobs">Jobs</a></li>
<li class="nav-item"><a class="nav-link" href="#">Applications</a></li>
<li class="nav-item"><a class="nav-link" href="/auth/logout">Logout</a></li>

</ul>

</div>

</nav>

<!-- ✅ HERO SECTION (FIXED) -->

<section class="hero">

<div class="container">

<h1>Welcome <%= student.name %> 👋</h1>

<p>Find your dream job through campus placements</p>

<!-- ✅ STUDENT INFO -->
<p><b>Email:</b> <%= student.email %></p>
<p><b>Branch:</b> <%= student.branch %></p>

<!-- ✅ SKILLS -->
<div class="mb-3">
  <b>Skills:</b><br>

  <% if(student.skills && student.skills.length > 0){ %>
    
    <% student.skills.forEach(skill => { %>
      <span class="badge bg-primary me-1"><%= skill %></span>
    <% }) %>

  <% } else { %>
    <p>No skills added</p>
  <% } %>
</div>

<!-- SEARCH -->
<input 
type="text"
class="form-control search-bar"
id="searchJob"
placeholder="Search jobs..."
onkeyup="searchJobs()"
/>

</div>

</section>

<!-- ✅ JOB SECTION -->

<section class="jobs-section">

<div class="container">

<h3 class="mb-4">Available Jobs</h3>

<!-- FILTERS -->

<div class="filters text-center mb-4">

<button class="btn btn-outline-primary" onclick="filterJobs('All')">All</button>
<button class="btn btn-outline-primary" onclick="filterJobs('software')">Software</button>
<button class="btn btn-outline-primary" onclick="filterJobs('aiml')">AI/ML</button>
<button class="btn btn-outline-primary" onclick="filterJobs('devops')">DevOps</button>
<button class="btn btn-outline-primary" onclick="filterJobs('data')">Data Science</button>
<button class="btn btn-outline-primary" onclick="filterJobs('cloud')">Cloud</button>

</div>

<!-- JOB GRID -->

<div class="row" id="jobsContainer"></div>

</div>

</section>

<!-- ✅ FOOTER -->

<footer class="footer">

<div class="container">

<div class="row">

<div class="col-md-4">
<h5>CampusHire</h5>
<p>Connecting students with top companies for campus placements.</p>
</div>

<div class="col-md-4">
<h5>Quick Links</h5>
<ul>
<li>Dashboard</li>
<li>Jobs</li>
<li>Applications</li>
<li>Profile</li>
</ul>
</div>

<div class="col-md-4">
<h5>Contact</h5>
<p>Email: support@campushire.com</p>
<p>Phone: +91 9876543210</p>
</div>

</div>

<hr>

<p class="text-center">© 2026 CampusHire | Placement Portal</p>

</div>

</footer>

<!-- ✅ SCRIPT -->




<script>

let allJobs = []; // store all jobs globally

async function loadJobs(){
  const res = await fetch("/api/jobs");
  const jobs = await res.json();

  allJobs = jobs; // store
  displayJobs(jobs);
}

// ✅ FILTER FUNCTION
function filterJobs(category){

  if(category === "All"){
    displayJobs(allJobs);
    return;
  }

  const filtered = allJobs.filter(job =>
    job.category && job.category.toLowerCase() === category.toLowerCase()
  );

  displayJobs(filtered);
}

// ✅ DISPLAY FUNCTION
function displayJobs(jobs){

  const container = document.getElementById("jobsContainer");
  container.innerHTML="";

  if(jobs.length === 0){
    container.innerHTML = "<p>No jobs found</p>";
    return;
  }

  jobs.forEach(job=>{

    let skillsHTML="";

    if(job.requiredSkills){
      job.requiredSkills.forEach(skill=>{
        skillsHTML += `<span class="badge bg-primary me-1">${skill}</span>`;
      });
    }

    const card = document.createElement("div");

    card.classList.add("col-md-4","mb-4");

    card.innerHTML = `

    <div class="card shadow jobCard h-100">

      <img src="https://source.unsplash.com/400x300/?technology,office"
      class="card-img-top">

      <div class="card-body">

      <h5 class="card-title">${job.jobTitle}</h5>

      <p class="card-text">
      <b>Category:</b> ${job.category || "N/A"} <br>
      <b>Location:</b> ${job.location || "N/A"} <br>
      <b>Package:</b> ₹${job.package || "N/A"} LPA
      </p>

      <div class="mb-2">
      ${skillsHTML}
      </div>

      <button class="btn btn-primary w-100"
      onclick="applyJob('${job._id}')">
      Apply Now
      </button>

      </div>

    </div>

    `;

    container.appendChild(card);

  });

}

// APPLY
async function applyJob(jobId){

  await fetch(`/api/applications/${jobId}`,{
    method:"POST"
  });

  alert("Application submitted");
}

window.onload = loadJobs;

</script>

</body>
</html>